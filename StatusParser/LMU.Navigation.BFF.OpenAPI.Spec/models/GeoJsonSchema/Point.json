{
  "title": "GeoJSON Point",
  "type": "object",
  "additionalProperties": false,
  "description": "\"$schema\": \"http://json-schema.org/draft-07/schema#\",\n\"$id\": \"http://geojson.org/schema/Point.json\"",
  "examples": [
    {
      "type": "Point",
      "coordinates": [
        0,
        0,
        0
      ]
    }
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Point"
      ],
      "description": "The value \"Point\""
    },
    "coordinates": {
      "type": "array",
      "minItems": 3,
      "description": "(longitude[deg], latitude[deg], altitude[m])",
      "items": {
        "type": "number"
      }
    }
  },
  "required": [
    "type",
    "coordinates"
  ]
}